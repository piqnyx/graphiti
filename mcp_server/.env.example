# Graphiti MCP Server Environment Configuration

# Neo4j Database Configuration
# These settings are used to connect to your Neo4j database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=demodemo

# OpenAI / OpenAI-compatible API Configuration
# Required for LLM operations
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4.1-mini

# Optional: non-standard OpenAI-compatible endpoint
# OPENAI_API_URL=https://api.openai.com/v1

# Hard deployment-wide completion ceiling. Individual Graphiti extraction helpers
# may request less but cannot exceed this. The default matches Graphiti's established
# 16K baseline; override explicitly for controlled live diagnostics/tuning.
LLM_MAX_TOKENS=16384

# Structured response transport. json_schema is preferred when the endpoint
# enforces it; use json_object for compatible gateways that do not.
LLM_STRUCTURED_OUTPUT_MODE=json_schema

# Optional provider-specific reasoning control. Leave unset until the exact model
# and gateway are known to support the chosen value.
# GRAPHITI_REASONING_EFFORT=none

# Optional exact request/response JSONL trace. Contains conversation/model content,
# never API credentials. Use only while diagnosing and protect the file accordingly.
# GRAPHITI_LLM_TRACE_FILE=/tmp/graphiti-llm-trace.jsonl

# Optional: Group ID for namespacing graph data
# GRAPHITI_GROUP_ID=my_project

# Concurrency Control
# Controls how many episodes can be processed simultaneously across groups.
# The reliable queue still processes each individual group strictly FIFO.
SEMAPHORE_LIMIT=10

# Provider retry policy for the current FIFO head. There is no terminal retry
# count: the durable caller owns the batch and later batches never overtake it.
# Backoff doubles after repeated failures and is capped here. Specific failure
# classes (429, balance/auth, output limit, outage) impose their own minimum delay.
EPISODE_PROCESS_RETRY_BASE_SECONDS=2
EPISODE_PROCESS_RETRY_MAX_SECONDS=3600

# Maximum pending in-memory server tasks per group. This is NOT the durable disk
# backlog; the OpenClaw-side queue is authoritative and may be much larger.
EPISODE_QUEUE_MAX_SIZE=100

# Optional: Path configuration for Docker
# PATH=/root/.local/bin:${PATH}

# Optional: Memory settings for Neo4j (used in Docker Compose)
# NEO4J_server_memory_heap_initial__size=512m
# NEO4J_server_memory_heap_max__size=1G
# NEO4J_server_memory_pagecache_size=512m

# Azure OpenAI configuration
# Optional: Only needed for Azure OpenAI endpoints
# AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-gpt-4o-mini-deployment
# AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large-deployment
# AZURE_OPENAI_USE_MANAGED_IDENTITY=false
